 
@page "/editgame"
@page "/editgame/{Id:int}"
@attribute [StreamRendering]
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject GokartokClient GClient
@inject BerloClient BClient
@inject BerlesClient B2Client

<PageTitle>@title</PageTitle> 
<h3>@title</h3>
 @if (Gokartok is  null || Berlok is null || Berles is null)
{
      <p><em>Loading...</em></p>
}
else
{      
    <div class="row">
    <div class="col-md-4">
    <EditForm Model="@Berles" FormName="editGame" OnValidSubmit="HandleSubmitAsync" Enhance>
    <DataAnnotationsValidator />
    <ValidationSummary />
       
   <div class="mb-3">
        <label for="gokart" class="form-label">Gokart:</label>
        <InputSelect id="gokart" class="form-select" @bind-Value="Berles.Gokart_Id" >
            <option value="">-- Select Gokart --</option>       
                @foreach (var gokart in Gokartok)
                {
                    if (gokart.Foglalt_e == 0)
                    {
                        <option value="@gokart.Id">@gokart.Gyarto @gokart.Tipus</option>
                    }
                    
                }        
        </InputSelect>
       <!-- <ValidationMessage For="() => Gokart.Tipus" />-->
    </div>  

<div class="mb-3">
        <label for="berlo" class="form-label">Bérlők:</label>

        <!-- Előre eldöntött értékek -->
       <InputSelect id="berlo" class="form-select" @bind-Value="Berles.Berlo_Id" >
            <option value="">-- Select Person --</option>       
                @foreach (var item in Berlok)
                {
                    <option value="@item.id">@item.Berlo_Neve</option>
                }      
        </InputSelect>    

        <!-- Kézzel beírható név értékek -->
     <!--   <InputText id="berlonev" class="form-control" @bind-Value="Berlo.Berlo_Neve" /> -->

        <!--<ValidationMessage For="() => Gokart.Tipus" />-->
    </div>
    
    <div class="mb-3">
        <label for="Kezodatum" class="form-label">Bérlés Kezdődátuma:</label>
        <InputDate id="Kezdodatum" class="form-control" @bind-Value="Berles.KezdoDatum" />
    </div> 
    <div class="mb-3">
        <label for="price" class="form-label">Days:</label>
        <InputNumber id="price" class="form-control" @bind-Value="Berles.Berles_hossza" />
        <!--<ValidationMessage For="() => Gokart.NapiAr" />-->
    </div>  
    <button type="submit" class="btn btn-primary">Save</button>
    <a role="button" class="btn btn-secondary" href="/">Cancel</a>  
</EditForm>
</div>
</div>
}

@code {
    
    [Parameter]
    public int? Id { get; set; }
    [SupplyParameterFromForm]
    private GokartDetails? Gokart { get; set; }
    private BerlesDetails? Berles { get; set; }
    public BerloDetails? Berlo { get; set; }  
    private BerloSummary[]? Berlok;
    private GokartSummary[]? Gokartok;    

    private string title = string.Empty;


    protected override async Task OnParametersSetAsync()
    {
        if (Berles is not null)
        {
            return;
        }

        if (Id is not null)
        {
            Berles = await B2Client.GetBerlesAsync(Id.Value);
            title = $"Edit {Berles.ID}";
        }
        else
        {
            Berles = new BerlesDetails()
            {                
                KezdoDatum = DateOnly.FromDateTime(DateTime.UtcNow)
            };
            title = "Új Berles";
        }
    }
    protected override async Task OnInitializedAsync() 
    {
        try
        {           
            Gokartok = await GClient.GetGokartokAsync();
            Berlok = await BClient.GetBerlokAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading data: {ex.Message}");
        }
    }

    private async Task HandleSubmitAsync()
    {
        ArgumentNullException.ThrowIfNull(Berles);

        if (Id is null)
        {
            await B2Client.AddBerlesAsync(Berles);
        }


        if (Id is not null)    
        {
            Berles.ID = Id.Value;
            await B2Client.UpdateBerlesAsync(Berles);
        }
        

        


        NavigationManager.NavigateTo("/");
    }   
}
