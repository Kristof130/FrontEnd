@page "/"
@using GameStore.Frontend.Clients
@using GameStore.Frontend.Models
@inject BerloClient BClient
@inject BerlesClient B2Client
@inject GokartokClient GClient
@attribute [StreamRendering]

<PageTitle>Gokart Catalog</PageTitle>

<div class="mt-2">
<a class="btn btn-primary" role="button" href="/editgame">Új Bérlés</a>
</div>

@if(Berles is null)
{
    <p><em>Loading...</em></p>
}
else {
    <table class="table table-striped table-bordered table-hover mt-3">
    <thead class="table-dark">
        
        <th>Gokart ID</th>
        <th>Bérlő ID</th>
        <th class="text-end">Berlés Kezdődátuma</th>
        <th>Bérlés Hossza</th>
        <th></th>
    </thead>
    <tbody>
        @foreach (var Berless in Berles)
        {
            <tr>

                <td>@GetGokartNev(Gokart, Berless.Gokart_Id)</td>
                <td>@GetBerloNev(Berlo, Berless.Berlo_Id)</td>
                <td class="text-end">@Berless.KezdoDatum</td>
                <td>@Berless.Berles_hossza</td>
                <td>
                    <div class="d-flex">
                        <a class="btn btn-primary me-2" role="button" href="@GameUrl(Berless.ID)">
                        <i class="bi bi-pencil"></i>
                        </a>
                        <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="@GetDeleteModalId(Berless)"><i class="bi bi-x-lg"></i></button> 
                    </div>
                    <DeleteBerles Berless="@Berless" />
                </td>                
            </tr>
        }
    </tbody>
    </table>
}

@code {
    private BerlesSummary[]? Berles;
    private BerloSummary[]? Berlo;
    private GokartSummary[]? Gokart;


    
    
    public static string GetGokartNev(GokartSummary[] gokart, int id)
    {
        foreach (var item in gokart)
                {
                    if (item.Id == id)
                    {
                         return item.Gyarto + " " + item.Tipus;
                    }
                }
      
        return "N/A";
    }

public static string GetBerloNev(BerloSummary[] berlo, int id)
    {
        foreach (var item in berlo)
                {
                    if (item.id == id)
                    {
                         return item.Berlo_Neve;
                    }
                }
      
        return "N/A";
    }




    protected override async Task OnInitializedAsync()
    {
        Berles = await B2Client.GetBerlesekAsync();
        Gokart = await GClient.GetGokartokAsync();
        Berlo = await BClient.GetBerlokAsync();
    }

    private static string GameUrl(int id) => $"/editgame/{id}";     

    
    private string GetDeleteModalId(BerlesSummary Berles1) 
    {
        return $"#{DeleteBerles.GetModalId(Berles1)}";
    }
}

